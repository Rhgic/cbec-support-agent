# ===== 数据库 / 缓存 =====
# 单库：业务数据与向量同库（pgvector 扩展）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cbec
REDIS_URL=redis://localhost:6379/0

# ===== DeepSeek（OpenAI 兼容接口）=====
# 所有 LLM 调用统一走 services/llm.py，不直接在业务代码里调 SDK
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 注意：deepseek-chat 已下线，填它会让所有 LLM 调用 400 并静默退回兜底模板
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 17TRACK 物流轨迹 =====
# 新账号一次性 200 单号额度；注册成功后重复查询不再扣额度
TRACKING_API_KEY=
TRACKING_MODE=cache

# ===== 嵌入模型 BGE-m3 =====
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cpu

# ===== 护栏（限流 / 配额 / 熔断，详见规格第 8 节）=====
RATE_LIMIT_PER_MINUTE=20
DAILY_QUOTA_PER_TOKEN=500
BREAKER_COST_THRESHOLD_USD=5.0

# ===== 应用 =====
APP_ENV=dev
LOG_LEVEL=INFO
# 演示端用固定 token，不做注册登录体系（规格 1.2）
DEMO_TOKEN=dev-token
# PII 可逆加密密钥（依赖清单无 cryptography，用 stdlib 派生密钥；生产须换 AES-GCM）
PII_SECRET=change-me-in-prod
